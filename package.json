{
  "name": "kunz-global-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/render/prerender.tsx --outDir .prerender && node .prerender/prerender.js",
    "preview": "node scripts/serve.mjs 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test tests/site.test.mjs",
    "images": "node scripts/build-images.mjs",
    "globe": "node scripts/build-globe.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@fontsource-variable/inter-tight": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "d3-geo": "^3.1.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "world-atlas": "^2.0.2"
  }
}
